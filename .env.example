# Copier ce fichier en .env.local (jamais versionné) puis renseigner les valeurs
# depuis Supabase → Project Settings → API Keys.

# URL du projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique « publishable » (sb_publishable_…).
# Les projets plus anciens peuvent utiliser à la place la clé « anon » :
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi…
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse du compte administrateur (garde-fou d'interface uniquement :
# la protection réelle est la RLS via public.is_admin() et admin_allowlist).
VITE_ADMIN_EMAIL=vous@exemple.com

# Jamais ici : la clé service_role / secret de Supabase. L'app n'en a pas besoin.
