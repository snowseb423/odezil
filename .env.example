# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs.

# Projet Supabase (Settings > API). La clé publique peut être la clé « anon »
# historique ou la nouvelle clé « publishable » (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://<ref-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète « service_role » (ou sb_secret_...). Serveur uniquement :
# ne jamais la préfixer par NEXT_PUBLIC_ ni l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Seule adresse autorisée à administrer l'application (comparée en minuscules).
ADMIN_EMAIL=

# Secret aléatoire servant à hacher les tokens des liens partagés (HMAC-SHA256).
# Générer avec : openssl rand -base64 32
# Le changer invalide tous les liens existants.
SHARE_TOKEN_PEPPER=
